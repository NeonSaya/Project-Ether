[Events]
// Timeline, colour, negative vector scale, parameter windows.
Sprite,Background,Centre,"baseline.png",320,240
 F,0,0,1000,0.2,0.8
 M,0,0,1000,20,30,220,130
 S,0,0,1000,1,2
 V,0,0,1000,1,2,-1,0.5
 R,0,0,1000,0,3.141592653589793
 C,0,0,1000,0,0,0,255,255,255
 P,0,250,750,H
 P,0,500,750,V
 P,0,100,900,A
// Nonzero child start is intentional: tests loop start and period.
Sprite,Foreground,TopLeft,"loop-offset.png",10,20
 L,1000,3
  M,0,100,400,0,0,300,150
  F,0,100,400,0.2,0.8
  C,0,100,400,255,0,0,0,0,255
// Parameter command with equal start/end: persistent until sprite lifetime.
Sprite,Foreground,Centre,"instant-flags.png",320,240
 F,0,0,1000,1,1
 P,0,250,250,H
 P,0,500,500,A
// Alpha >1 triggers DrawableStoryboardSprite.Update-specific compatibility.
Sprite,Foreground,Centre,"alpha-overflow.png",320,240
 F,0,0,1000,0.5,2.5
// Simultaneous move axes and old/new command overlap.
Sprite,Foreground,Centre,"overlap.png",320,240
 M,0,0,1000,0,0,100,100
 MX,0,500,1500,200,400
 MY,0,500,1500,300,500
 C,0,0,1000,255,0,0,0,255,0
 C,0,500,1500,0,0,255,255,255,255
