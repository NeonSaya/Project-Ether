<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.unity3d.player"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- 自定义 Activity：接管文件选择器的 onActivityResult 并回传 Unity，
             其余行为与 UnityPlayerActivity 完全一致（见 FilePickerActivity.java）。
             configChanges 必不可少：VR <-> 2D 选择器切换会触发 uiMode/screenSize
             等配置变化，缺失将导致 Activity 销毁重建、Unity 重新初始化（黑屏）。 -->
        <activity android:name="com.nyaon.projectether.FilePickerActivity"
                  android:theme="@style/UnityThemeSelector"
                  android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|layoutDirection|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
            <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
            <meta-data android:name="com.samsung.android.vr.application.mode" android:value="vr_only" />
            <meta-data android:name="pvr.app.type" android:value="vr" />
            <meta-data android:name="pvr.app.splash.bg" android:value="0" />
            <meta-data android:name="enable_entitlementcheck" android:value="0" />
        </activity>
    </application>
</manifest>
